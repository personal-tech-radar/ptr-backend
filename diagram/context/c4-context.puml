@startuml C4 Container - Personal Tech Radar
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

HIDE_STEREOTYPE()

title Personal Tech Radar — Container View

Person(user, "Backend Architect", "Receives daily\ndigest email")

System_Ext(feeds, "RSS / Atom / GitHub Feeds", "Engineering blogs and\nGitHub release pages")
System_Ext(openai, "OpenAI API", "Chat completions\nwith JSON mode")
System_Ext(resend, "Resend", "Transactional\nemail delivery")

System_Boundary(ptr, "Personal Tech Radar Backend") {

    Container(scheduler, "Scheduler", "NestJS Schedule · cron", "Fires fetch-all-sources\nevery hour.\nFires build-daily-digest daily\nat configured UTC time.")

    Container(queue, "Queue Broker", "BullMQ", "Three named queues:\nfeed-fetch · article-analysis · digest.\nJobs are persisted in Redis so they\nsurvive restarts. Workers pick up\njobs concurrently and retry on failure.")

    Container(fetcher, "FeedFetcher", "rss-parser", "Downloads and parses\nRSS / Atom / GitHub release feeds.\nDeduplicates by URL hash.\nSkips near-duplicates by title hash\nwithin a 7-day window.")

    Container(analysis, "AiAnalysis", "OpenAI SDK", "Loads user interests from config.\nScores each article for relevance\nand quality. Decides whether\nthe article belongs in the digest.")

    Container(digest, "Digest Builder", "NestJS", "Queries analyzed articles\nfrom the last 24 hours.\nRanks by weighted score:\nrelevance 45 · quality 30\ntrust 15 · recency 10.\nApplies source and category\ndiversification. Selects top 5.\nRenders HTML and plain-text email.")

    Container(mail, "Mail", "Resend SDK", "Delivers the rendered\ndigest email via Resend.\nExposes POST /digests/daily/resend-latest\nto re-send without rebuilding.")

    ContainerDb(postgres, "PostgreSQL", "TypeORM", "sources\narticles\narticle_analyses\ndigests\ndigest_items")

    ContainerDb(redis, "Redis", "BullMQ store", "Persists queued jobs\nand worker state")
}

Rel(scheduler, queue, "Dispatches", "fetch-all-sources\nbuild-daily-digest")

Rel(queue, redis, "Persists and reads jobs", "TCP · BullMQ protocol")

Rel(queue, fetcher, "Triggers worker", "fetch-all-sources\nfetch-source")
Rel(queue, analysis, "Triggers worker", "analyze-article")
Rel(queue, digest, "Triggers worker", "build-daily-digest")

Rel(fetcher, feeds, "Fetches feeds", "HTTP")
Rel(fetcher, postgres, "Saves new articles", "INSERT articles")
Rel(fetcher, queue, "Enqueues per new article", "analyze-article")

Rel(analysis, openai, "Sends title, summary,\nuser interests", "HTTPS · JSON")
Rel(openai, analysis, "Returns relevanceScore, qualityScore,\nwhyItMatters, tags, shouldInclude", "HTTPS · JSON")
Rel(analysis, postgres, "Stores analysis result", "INSERT article_analyses")

Rel(digest, postgres, "Reads analyzed articles,\nwrites digest and items", "SELECT · INSERT")
Rel(digest, mail, "Passes built digest")

Rel(mail, resend, "Sends email", "HTTPS · Resend API")
Rel(resend, user, "Delivers daily digest", "Email")

@enduml
