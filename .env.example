APP_NAME=ptr-backend
PORT=3000
NODE_ENV=development
CORS_ORIGINS=https://app.example.com
SWAGGER_SERVER_URL=http://backend:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ptr

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

API_KEY=change-this-api-key-in-production
APP_URL=http://localhost:3000
FEEDBACK_TOKEN=change-this-feedback-token-in-production

# JWT auth (AuthModule) — access token
JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRES_IN=15m
# Refresh tokens are persisted/hashed/revocable (RefreshToken entity), not JWT-signed.
JWT_REFRESH_EXPIRES_IN=30d
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_HOURS=2

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin12345
S3_BUCKET=ptr
S3_FORCE_PATH_STYLE=true

HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=3
HTTP_RETRY_DELAY_MS=1000

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Playwright browser-fetch fallback (web source discovery, last resort after sitemap/RSS/Cheerio)
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_QUEUE_CONCURRENCY=1
PLAYWRIGHT_TIMEOUT_MS=30000

# OpenAI structural fallback for web source discovery (last resort after Playwright)
SOURCE_DISCOVERY_AI_FALLBACK_ENABLED=false
SOURCE_DISCOVERY_AI_FALLBACK_MAX_PER_DAY=10

RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=digest@yourdomain.com
DIGEST_TO_EMAIL=you@example.com
DAILY_DIGEST_ARTICLES_LIMIT=3

FETCH_CRON=0 * * * *
DIGEST_CRON=0 7 * * 1-5
WEEKLY_DIGEST_CRON=0 8 * * 5
DEEP_DIVE_CRON=0 8 * * 1
