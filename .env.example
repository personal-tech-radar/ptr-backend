APP_NAME=ptr-backend
PORT=3000
NODE_ENV=development
CORS_ORIGINS=https://app.example.com
SWAGGER_SERVER_URL=http://backend:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ptr

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

API_KEY=change-this-api-key-in-production
APP_URL=http://localhost:3000
# HMAC secret signing save-from-email links (SaveLinkSignatureService, UserActionsModule)
SAVE_LINK_SECRET=change-this-save-link-secret-in-production

# JWT auth (AuthModule) — access token
JWT_SECRET=change-this-jwt-secret-in-production
JWT_EXPIRES_IN=15m
# Refresh tokens are persisted/hashed/revocable (RefreshToken entity), not JWT-signed.
JWT_REFRESH_EXPIRES_IN=30d
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# Admin Bootstrap (AdminBootstrapService) — runs on every startup. ADMIN_EMAIL and
# ADMIN_PASSWORD are BOTH required; the app fails to boot if either is unset. If a user
# already exists with ADMIN_EMAIL, bootstrap never resets their password — an active user
# is left untouched, a soft-deleted one is automatically restored as an admin (also without
# touching its password hash).
ADMIN_EMAIL=
ADMIN_PASSWORD=change-this-admin-password-in-production

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin12345
S3_BUCKET=ptr
S3_FORCE_PATH_STYLE=true

HTTP_TIMEOUT_MS=10000
HTTP_RETRIES=3
HTTP_RETRY_DELAY_MS=1000

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Playwright browser-fetch fallback (web source discovery, last resort after sitemap/RSS/Cheerio)
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_QUEUE_CONCURRENCY=1
PLAYWRIGHT_TIMEOUT_MS=30000

# OpenAI structural fallback for web source discovery (last resort after Playwright)
SOURCE_DISCOVERY_AI_FALLBACK_ENABLED=false
SOURCE_DISCOVERY_AI_FALLBACK_MAX_PER_DAY=10

# Taxonomy (technology/interest resolver + isolated source-discovery stub queue)
TAXONOMY_SIMILARITY_THRESHOLD=0.6
TAXONOMY_SOURCE_DISCOVERY_QUEUE_CONCURRENCY=2

RESEND_API_KEY=re_...
DIGEST_FROM_EMAIL=digest@yourdomain.com
DAILY_DIGEST_ARTICLES_LIMIT=3
WEEKLY_DIGEST_ARTICLES_LIMIT=5
# Worker concurrency for the digest queue (DigestProcessor) — bounds how many
# send-personal-digest/digest-sweep jobs run at once.
DIGEST_QUEUE_CONCURRENCY=5

FETCH_CRON=0 * * * *
# Personal Digest Delivery (DigestModule) — a single sweep cron replaces the old fixed-UTC
# per-cadence crons. DigestSweepService evaluates every eligible user's own local send-time window
# on each tick: daily fires Mon-Fri only at DAILY_DIGEST_SEND_HOUR local time; weekly fires Friday
# 14:00 local, fixed and not configurable.
DIGEST_SWEEP_CRON=*/15 * * * *
DAILY_DIGEST_SEND_HOUR=8

# Personal Feed (FeedModule)
# Cached computed feed response TTL, in seconds.
FEED_CACHE_TTL_SECONDS=600
# Max `days` query param value, and the width (in days, counting back from today) of the
# permanent floor applied to the non-saved feed — articles older than this are never returned
# regardless of the requested range. saved=true is exempt from this floor.
FEED_MAX_DAYS=30

# Public Feed + Anonymous Preview (PublicFeedModule)
# Cached response TTL, in seconds, shared by both GET /public/feed and POST /public/feed/preview.
PUBLIC_FEED_CACHE_TTL_SECONDS=600
